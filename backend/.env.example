# Competitive Intelligence Platform - Backend Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# API Keys (Required - at least one provider)
# =============================================================================

# OpenAI API Key (for GPT models)
OPENAI_API_KEY=sk-...

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API Key
GEMINI_API_KEY=...

# xAI API Key (for Grok models)
XAI_API_KEY=...

# Perplexity API Key (for Sonar models)
PERPLEXITY_API_KEY=pplx-...

# Tavily API Key (for deep research search)
TAVILY_API_KEY=tvly-...

# =============================================================================
# Server Configuration
# =============================================================================

# CORS allowed origins (comma-separated for multiple origins)
# Default: http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# Deep Research Configuration
# =============================================================================

# Timeout for deep research operations (seconds)
DEEP_RESEARCH_TIMEOUT_SECONDS=300

# LangGraph server URL for open deep research
LANGGRAPH_URL=http://localhost:2024
